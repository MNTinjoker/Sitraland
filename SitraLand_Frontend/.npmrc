# angular-notifier (latest 14.0.0) and ng-select2 (latest 1.4.1) publish stale
# peerDependency ranges (Angular 16 / Angular 13). Both libraries only rely on
# stable Angular APIs (Renderer2, NgZone, ElementRef, NG_VALUE_ACCESSOR) and
# work on the current Angular version, so peer resolution is relaxed here.
legacy-peer-deps=true
